---
import SiteLayout from '../shared/layouts/SiteLayout.astro';
import Article from '../features/writing/Article.astro';
import { getPublishedPosts } from '../features/writing/query';
const post = (await getPublishedPosts()).find(
  (post) => post.data.slug === 'google-chrome-dino-hax',
);
if (!post)
  throw new Error(
    'The legacy article must remain published to preserve its URL.',
  );
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  article
  date={post.data.date}
>
  <Article post={post} />
</SiteLayout>
