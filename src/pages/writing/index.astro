---
import SiteLayout from '../../shared/layouts/SiteLayout.astro';
import Journal from '../../features/writing/Journal.astro';
import { getPublishedPosts } from '../../features/writing/query';
import Interests from '../../features/about/Interests.astro';
const posts = await getPublishedPosts();
---

<SiteLayout
  title="Writing"
  description="What I’m working on. What I’m figuring out. Engineering, AI, and occasional detours."
>
  <section class="page">
    <p class="eyebrow">The journal</p>
    <h1>
      What I’m working on.
      <br />What I’m figuring out.
    </h1>
    <p class="intro">
      Engineering, AI, and occasional detours. Room for a deep dive and a
      thought that doesn't need a diagram.
    </p>
    <div class="editorial-grid">
      <Journal posts={posts} />
      <Interests />
    </div>
  </section>
</SiteLayout>
