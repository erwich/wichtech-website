---
import SiteLayout from '../shared/layouts/SiteLayout.astro';
import ContactForm from '../features/contact/ContactForm.astro';
---

<SiteLayout
  title="Contact"
  description="Have a project in mind, a question, or a shared interest? Say hello to Eric Wich."
>
  <section class="page">
    <p class="eyebrow">Say hello</p>
