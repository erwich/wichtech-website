---
import SiteLayout from '../shared/layouts/SiteLayout.astro';
import Button from '../shared/components/Button.astro';
---

<SiteLayout title="Page not found" noindex>
  <section class="page">
    <p class="eyebrow">404</p>
    <h1>
      A little off
      <br />
      the beaten path.
    </h1>
    <p class="intro">
      This page has moved or doesn't exist. There's still plenty to explore.
    </p>
    <Button href="/">Head home ↗</Button>
  </section>
</SiteLayout>
