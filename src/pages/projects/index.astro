---
import SiteLayout from '../../shared/layouts/SiteLayout.astro';
import ProjectGrid from '../../features/projects/ProjectGrid.astro';
import { getProjects } from '../../features/projects/query';
const projects = await getProjects();
---

<SiteLayout
  title="Projects"
  description="Selected work by Eric Wich: Revelation and Serenity Hobbies."
>
  <section class="page">
    <p class="eyebrow">Selected work</p>
    <h1>
      Things I've
      <br />
      helped build.
    </h1>
    <p class="intro">
      Software, community projects, and experiments. A few places where an idea
      became something people could use.
    </p>
    <ProjectGrid projects={projects} />
  </section>
</SiteLayout>
