---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../shared/layouts/SiteLayout.astro';
import ProjectDetail from '../../features/projects/ProjectDetail.astro';
import { getProjects } from '../../features/projects/query';
export const getStaticPaths = (async () =>
  (await getProjects()).map((project) => ({
    params: { id: project.id },
    props: { project },
  }))) satisfies GetStaticPaths;
const { project } = Astro.props;
---

<SiteLayout title={project.data.title} description={project.data.description}>
  <ProjectDetail project={project} />
</SiteLayout>
