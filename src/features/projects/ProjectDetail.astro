---
import { render, type CollectionEntry } from 'astro:content';
import Button from '../../shared/components/Button.astro';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);
---

<section class="page">
  <a class="text-link" href="/projects/">
    ← All projects
  </a>
  <article class="reading">
    <p class="eyebrow">{project.data.category}</p>
    <h1>{project.data.title}</h1>
    <p class="deck">{project.data.description}</p>
    <div class="prose">
      <Content />
    </div>
    <div class="actions">
      {project.data.website && (
        <Button href={project.data.website} external>
          Visit the site
        </Button>
      )}
      {project.data.source && (
        <Button href={project.data.source} secondary external>
          View source
        </Button>
      )}
      <Button href="/contact/" secondary>
        Ask me about this project
      </Button>
    </div>
  </article>
</section>
