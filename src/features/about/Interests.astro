---
import './about.css';

const interests = [
  {
    label: 'Music & worship',
    paths: [
      'M9 18V5l12-2v13',
      'M9 8l12-2',
      'M9 18c0 1.7-1.6 3-3.5 3S2 19.7 2 18s1.6-3 3.5-3S9 16.3 9 18Z',
      'M21 16c0 1.7-1.6 3-3.5 3s-3.5-1.3-3.5-3 1.6-3 3.5-3 3.5 1.3 3.5 3Z',
    ],
  },
  {
    label: 'RPGs & good stories',
    paths: [
      'M12 2 22 8v8l-10 6-10-6V8Z',
      'M12 2 7 10l5 9 5-9Z',
      'M2 8l5 2h10l5-2',
      'M2 16l10 3 10-3',
      'M12 19v3',
    ],
  },
  {
    label: 'Food worth sharing',
    paths: [
      'M13 2c1 6-5 6-3 11 2-1 3-3 3-5 4 3 6 6 6 9a7 7 0 0 1-14 0c0-5 5-7 8-15Z',
    ],
  },
];
---

<aside class="interests">
  <p class="eyebrow">Off the clock</p>
  <h3>More than a keyboard.</h3>
  <p>
    Music. Family. Fantasy.
    <br />
    Something good on the grill.
  </p>
  <ul>
    {interests.map(({ label, paths }) => (
      <li>
        <svg
          class="interest-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          {paths.map((d) => (
            <path d={d} />
          ))}
        </svg>
        <span>{label}</span>
      </li>
    ))}
  </ul>
  <a class="text-link" href="/about/">
    A little about me ↗
  </a>
</aside>
