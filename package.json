{
  "name": "wichtech-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "deploy": "wrangler deploy",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "~5.9.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
